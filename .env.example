# Copy to .env.local for local development. Setup notes: docs/contact-backend.md

# Postgres. Production: Neon's pooled connection string. Local: the PGlite server from `npm run db:dev`.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# Only when the portfolio lives in a schema of a shared database instead of its own database.
DATABASE_SCHEMA=

# Resend API key for the new-message email. Optional: without it messages are still stored.
RESEND_API_KEY=

# Where the notification goes. Defaults to the address in lib/content/profile.ts.
CONTACT_TO_EMAIL=

# Admin panel password (32+ characters) and the key that signs its session cookie. `openssl rand -hex 32`
INBOX_SECRET=

# Salt for hashing visitor IPs (rate limits, daily pulse visitor ids); raw IPs are never stored. `openssl rand -hex 32`
IP_HASH_SALT=

# Public origin: canonical URLs, and the only Origin the contact API accepts in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Host the admin panel answers on. Locally: admin.localhost (Chromium resolves it to loopback).
ADMIN_HOST=admin.localhost

# Set to 1 to record page views from localhost while developing the pulse analytics.
PULSE_DEV=

# Bearer token Vercel Cron sends to /api/cron (daily prune + notification retry). `openssl rand -hex 32`
CRON_SECRET=
